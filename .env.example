# Required for Docker Compose. Generate both values independently before deployment:
#   openssl rand -base64 32
AGENT_SESSION_ENCRYPTION_KEY=<generated-fernet-key>
AGENT_SECRET_ENCRYPTION_KEY=<generated-fernet-key>
POSTGRES_PASSWORD=<generated-database-password>
MINIO_ROOT_PASSWORD=<generated-minio-password>

# Business/provider keys are created in the platform Secret Vault and are not stored here.

# Optional production overrides
# POSTGRES_USER=agent
# POSTGRES_DB=agent_platform
